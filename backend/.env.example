# PostgreSQL / Supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Authentication
JWT_SECRETKEY=generate-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-secret-key

# Infrastructure
REDIS_PASSWORD=change-me
RABBITMQ_USERNAME=eduflex
RABBITMQ_PASSWORD=change-me

# Local Grafana (used by docker-compose.monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
EDUFLEX_ENVIRONMENT=local
POSTGRES_MONITOR_PASSWORD=change-me

# Optional grounded AI generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional password reset delivery. Leave disabled until SMTP is configured.
PASSWORD_RESET_DELIVERY_ENABLED=false
PASSWORD_RESET_FROM=
PASSWORD_RESET_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Local demonstration checkout; it never charges a real payment method.
PAYMENT_SIMULATION_ENABLED=true
